[include]
	path = ~/.config/delta/themes.gitconfig

[core]
	editor = nvim
    excludesfile = ~/.config/git/.gitignore_global
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
	features = catppuccin-macchiato

[merge]
    conflictStyle = zdiff3

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[init]
    defaultBranch = main

[fetch]
	prune = true

[push]
	autoSetupRemote = true

[pull]
	rebase = true

[rerere]
  # reuse recorded conflict resolutions automatically
  enabled = true

[alias]
    ck = checkout
    # fuzzy-find a branch and check it out
    ckb = !git branch | fzf | cut -c 3- | xargs git checkout
    amend = commit --amend --no-edit
    addexe = add --chmod=+x
    glimpse = show --stat
    rebaes = rebase
    # fetch and checkout branch
    new = !git fetch && git checkout $1 && git pull && :
    # delete remote and local (force) branch
    nuke = !git push -d origin $1 && git branch -D $1 && :
    # print the remote branch which the current local branch is tracking
    curry = rev-parse --abbrev-ref --symbolic-full-name @{u}
    # reset to origin hard
    roh = !git reset --hard $(git curry)
